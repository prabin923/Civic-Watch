DATABASE_URL="file:./dev.db"
DEMO_MODE=true
AUTH_REQUIRED=false
# Local image-place analysis is the default: the service runs Tesseract locally and
# deletes its temporary image after OCR. Install Tesseract on the server first.
LOCAL_TESSERACT_ENABLED=true
LOCAL_TESSERACT_COMMAND=tesseract
# Primary Tesseract language data bundled with the local install.
LOCAL_TESSERACT_LANGUAGES=eng
# Optional second pass for Nepali/Devanagari. On Homebrew after `brew install
# tesseract-lang`, use: /opt/homebrew/opt/tesseract-lang/share/tessdata
LOCAL_TESSERACT_SECONDARY_LANGUAGE=
LOCAL_TESSERACT_SECONDARY_TESSDATA_DIR=
# Point only to an agency-operated Nominatim instance. Never use the public OSM endpoint.
LOCAL_NOMINATIM_URL=

# Optional provider fallback. It is disabled by default, so this app does not call Google
# Vision or Google Geocoding unless this setting and AI_EXTERNAL_PROVIDER_AUTHORIZED are
# explicitly enabled under documented authority.
PLACE_ANALYSIS_GOOGLE_FALLBACK=false
GOOGLE_VISION_API_KEY=
GOOGLE_GEOCODING_API_KEY=

# Optional identifiers used by the model-governance console. Vertex training jobs use an
# agency service account / workload identity in the approved cloud environment; do not
# place a service-account JSON key in this file or in the browser.
GOOGLE_CLOUD_PROJECT=
VERTEX_AI_REGION=asia-south1
# CivicWatch AI v1 remains local/mock by default. Enabling Vertex requires an
# agency-approved project, server-side Application Default Credentials or
# workload identity, and explicit authorization for external processing.
GOOGLE_CLOUD_STORAGE_BUCKET=
VERTEX_AI_MODEL_ENDPOINT=
VERTEX_AI_ENABLED=false
AI_EXTERNAL_PROVIDER_AUTHORIZED=false
VERTEX_AI_TIMEOUT_MS=12000
VERTEX_AI_CIRCUIT_BREAKER_FAILURES=3
VERTEX_AI_CIRCUIT_BREAKER_COOLDOWN_MS=60000
AI_MAX_REQUESTS_PER_MINUTE=30
